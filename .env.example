# Local development uses a SQLite file. For Turso, set the libsql:// URL and a token.
TURSO_DATABASE_URL=file:./data/ajaia.sqlite
# TURSO_AUTH_TOKEN=
DEMO_ALEX_PASSWORD=local-alex-demo
DEMO_SAM_PASSWORD=local-sam-demo
# Set to true when serving locally over HTTPS. Production defaults to true.
# SESSION_COOKIE_SECURE=false
